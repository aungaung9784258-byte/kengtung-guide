# ===========================================================================
# Android
# ===========================================================================
# local.properties holds YOUR machine's SDK paths (D:\Android\Sdk ...).
# It must never be committed: it breaks the build on every other computer.
android/local.properties
android/.gradle/
android/captures/
android/app/debug/
android/app/profile/
android/app/release/
android/.cxx/
*.jks
*.keystore
key.properties

# ===========================================================================
# iOS / macOS
# ===========================================================================
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework/
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Flutter/ephemeral/
**/Flutter/App.framework/
**/Flutter/flutter_assets/
.DS_Store

